# Cloud GPU serving OpenAI-compatible APIs for both the LLM and the embedding model.
# Copy this file to .env, then edit the URLs. The notebook loads .env (not this file).
#
#   cp env.example .env
#
# On the GPU pod (notebook and vLLM on the same machine):
#   GPU_LLM_URL=http://127.0.0.1:8000/v1
#   GPU_EMBEDDING_URL=http://127.0.0.1:8002/v1
#
# From a laptop via the RunPod HTTP proxy (expose ports 8000 and 8002):
#   GPU_LLM_URL=https://<POD_ID>-8000.proxy.runpod.net/v1
#   GPU_EMBEDDING_URL=https://<POD_ID>-8002.proxy.runpod.net/v1

# Required: OpenAI-compatible chat completions endpoint, including the /v1 suffix
GPU_LLM_URL=http://your-gpu-host:8000/v1

# Required: OpenAI-compatible embeddings endpoint, including the /v1 suffix
# Second vLLM process. On RunPod do not use port 8001 (nginx already binds it).
GPU_EMBEDDING_URL=http://your-gpu-host:8002/v1

# Optional: leave empty if the GPU server does not require auth
GPU_API_KEY=

# Model names as registered on the GPU server (must match --served-model-name)
LLM_MODEL_NAME=esa-sceva/llama3-satcom-8b
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-4B
